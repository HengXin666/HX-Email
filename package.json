{
  "name": "hx-email",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npm run test --prefix web && uv run --directory server pytest",
    "build": "npm run build --prefix web",
    "verify-notes": "node .agents/skills/hx-agent-notes/scripts/cli/verify-all.ts",
    "verify-notes:staged": "node .agents/skills/hx-agent-notes/scripts/cli/verify-all.ts --staged",
    "verify-notes:tree": "node .agents/skills/hx-agent-notes/scripts/cli/verify-tree.ts",
    "verify-notes:format": "node .agents/skills/hx-agent-notes/scripts/cli/verify-format.ts",
    "verify-notes:coverage": "node .agents/skills/hx-agent-notes/scripts/cli/verify-coverage.ts",
    "verify-notes:backlinks": "node .agents/skills/hx-agent-notes/scripts/cli/verify-backlinks.ts",
    "notes:new": "node .agents/skills/hx-agent-notes/scripts/authoring/new-note.ts",
    "notes:archive": "node .agents/skills/hx-agent-notes/scripts/authoring/archive-note.ts",
    "notes:board": "node .agents/skills/hx-agent-notes/scripts/authoring/build-board.ts --init board.html"
  }
}
