server {
    listen ${LISTEN_PORT};
    listen [::]:${LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Data import payloads can be large
    client_max_body_size 64m;

    # Business API (/api/v1) + external API (/api/external)
    location /api/ {
        proxy_pass ${API_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Refresh progress uses SSE — buffering would stall the event stream
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # OpenAPI spec + interactive docs (Swagger UI / ReDoc)
    location = /openapi.json {
        proxy_pass ${API_TARGET};
    }

    location /docs {
        proxy_pass ${API_TARGET};
    }

    location /redoc {
        proxy_pass ${API_TARGET};
    }

    location = /health {
        proxy_pass ${API_TARGET};
    }

    location = /healthz {
        proxy_pass ${API_TARGET};
    }

    # Backend-served images (platform logos etc.)
    location /img/ {
        proxy_pass ${API_TARGET};
    }

    # Static brand pages (Google OAuth brand verification).
    # Google requires a publicly reachable homepage + privacy policy URL.
    # Pages are served directly (no redirect) so proxies that rewrite Location
    # headers can never break the public URLs Google reviewers fetch.
    location = /home { try_files /home.html =404; }
    location = /home/ { try_files /home.html =404; }
    location = /privacy { try_files /privacy.html =404; }
    location = /privacy/ { try_files /privacy.html =404; }
    location = /privacy-policy { try_files /privacy.html =404; }
    location = /terms { try_files /terms.html =404; }
    location = /terms/ { try_files /terms.html =404; }
    location = /terms-of-service { try_files /terms.html =404; }

    # Site root serves the public brand homepage, so visitors (and Google
    # reviewers) can learn about the app without logging in first.
    location = / { try_files /home.html =404; }

    # Brand pages must never be cached by the CDN/proxies so Google reviewers
    # always fetch the latest content (no stale snapshots).
    location ~ ^/(home\.html|privacy\.html|terms\.html|index\.html|manifest\.webmanifest|robots\.txt|favicon\.svg|icon-[0-9]+\.png)$ {
        try_files $uri =404;
        add_header Cache-Control "no-store, max-age=0" always;
    }

    # Google site-verification files uploaded through the admin UI are stored
    # on the backend; proxy the exact /google<hash>.html paths so Google can
    # fetch them unauthenticated.
    location ~ ^/google[0-9a-z]+\.html$ {
        proxy_pass ${API_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback for react-router paths
    location / {
        try_files $uri /index.html;
    }
}
