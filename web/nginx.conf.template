server {
    listen ${LISTEN_PORT};
    listen [::]:${LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Data import payloads can be large
    client_max_body_size 64m;

    # Business API (/api/v1) + external API (/api/external)
    location /api/ {
        proxy_pass ${API_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Refresh progress uses SSE — buffering would stall the event stream
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # OpenAPI spec + interactive docs (Swagger UI / ReDoc)
    location = /openapi.json {
        proxy_pass ${API_TARGET};
    }

    location /docs {
        proxy_pass ${API_TARGET};
    }

    location /redoc {
        proxy_pass ${API_TARGET};
    }

    location = /health {
        proxy_pass ${API_TARGET};
    }

    location = /healthz {
        proxy_pass ${API_TARGET};
    }

    # Backend-served images (platform logos etc.)
    location /img/ {
        proxy_pass ${API_TARGET};
    }

    # SPA fallback for react-router paths
    location / {
        try_files $uri /index.html;
    }
}
