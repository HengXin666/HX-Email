HX_EMAIL_DATA_DIR=data
HX_EMAIL_ADMIN_USERNAME=admin
HX_EMAIL_ADMIN_PASSWORD=admin
# Production: set a long random value and keep it stable across restarts.
HX_EMAIL_SECRET_KEY=

# 主从同步 (从机配置): 填主实例 (VPS) 地址和主实例管理员 Bearer token。
# 从机启动服务时会立即同步一轮, 之后按间隔周期同步; 也可用 CLI 手动同步:
#   hx-email sync
# 间隔设为 0 表示仅启动时同步一次 (CLI 始终可用)。
HX_EMAIL_SYNC_URL=
HX_EMAIL_SYNC_TOKEN=
HX_EMAIL_SYNC_INTERVAL_SECONDS=300

# Docker deploy ports (docker-compose.yml / docker-compose.bridge.yml)
# HX_EMAIL_HTTP_PORT=8080
# HX_EMAIL_BACKEND_PORT=18090

# Docker 自动更新 (设置 → 系统状态 → 立即更新)
# compose 文件默认挂载 docker.sock 与 ./:/compose 并默认启用; 关闭可设为 false
HX_EMAIL_UPDATE_ENABLED=true
# 拉取/构建镜像时使用的标签 (发布镜像: vX.Y.Z 与 latest)
# HX_EMAIL_IMAGE_TAG=latest

# SSRF 守卫: 默认放行私网/内网代理与 IMAP 主机 (本机/LAN 代理、Docker 桥接网关),
# 仅拦截云元数据/link-local/组播等危险保留段;
# 公网多租户部署可设 false 收紧为白名单 (仅 127.0.0.0/8、::1、host.docker.internal 与公网)
# HX_EMAIL_ALLOW_PRIVATE_PROXY=true
